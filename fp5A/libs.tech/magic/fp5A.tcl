# FP5A Magic PDK setup (sourced by fp5A.magicrc)
# Device extraction uses the SCN3ME_SUBM.30 extraction rules in fp5A.tech.
# The names below match the SPICE netlists in libs.ref/fp5_osu/spice.

set VDD vdd
set GND gnd

# Keep substrate/well extraction consistent with the KLayout LVS deck.
set SUBSTRATE gnd
