          "1.91034, 2.12743, 2.60287, 2.98428, 4.30552");
      }
    }
  }
}



  cell (TIEHI) {
    pg_pin (vdd) { pg_type : primary_power; voltage_name : "vdd"; }
    pg_pin (gnd) { pg_type : primary_ground; voltage_name : "gnd"; }
    area : 144;
    dont_touch : true;
    cell_leakage_power : 0;
    pin (Y) {
      direction : output;
      function : "1";
      max_capacitance : 1.0;
    }
  }

  cell (TIELO) {
    pg_pin (vdd) { pg_type : primary_power; voltage_name : "vdd"; }
    pg_pin (gnd) { pg_type : primary_ground; voltage_name : "gnd"; }
    area : 144;
    dont_touch : true;
    cell_leakage_power : 0;
    pin (Y) {
      direction : output;
      function : "0";
      max_capacitance : 1.0;
    }
  }

  /* Physical-only filler cell; present in LEF and GDS. */
  cell (FILL) {
    area : 72;
    dont_touch : true;
    cell_leakage_power : 0;
    pg_pin (vdd) {
      pg_type : primary_power;
      voltage_name : "vdd";
    }
    pg_pin (gnd) {
      pg_type : primary_ground;
      voltage_name : "gnd";
    }
  }

  cell (TAP) {
