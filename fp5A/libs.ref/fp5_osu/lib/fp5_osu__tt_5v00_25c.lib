        index_1 ("0.025, 0.05, 0.1, 0.3, 0.6");
        index_2 ("0.06, 0.18, 0.42, 0.6, 1.2");
        values ( \
          "1.88821, 2.09474, 2.60683, 3.01209, 4.4239", \
          "1.89246, 2.09064, 2.59176, 3.00054, 4.39187", \
          "1.90207, 2.12092, 2.5993, 2.99902, 4.35773", \
          "1.90385, 2.12564, 2.60292, 2.9874, 4.31866", \
          "1.91034, 2.12743, 2.60287, 2.98428, 4.30552");
      }
    }
  }
}



  cell (TIEHI) {
    pg_pin (vdd) { pg_type : primary_power; voltage_name : "vdd"; }
    pg_pin (gnd) { pg_type : primary_ground; voltage_name : "gnd"; }
    area : 144;
