  nom_process : 1;
  nom_voltage : 5;
  voltage_map (vdd, 5.0);
  voltage_map (gnd, 0.0);
  default_max_transition : 2.0 ; /* added by FP5: OSU lib has none; needed by CTS / repair */
  nom_temperature : 25;
  operating_conditions ( typical ) {
